generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────

enum UserType {
  CUSTOMER
  ADMIN
  DRIVER
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Status {
  ENABLED
  DISABLED
}

enum LoginType {
  PHONE
  EMAIL
  GOOGLE
  APPLE
}

enum DeliveryType {
  EXPRESS
  ECO
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PACKED
  DRIVER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
}

enum InventoryReason {
  RESTOCK
  ORDER_DEDUCTION
  MANUAL_ADJUSTMENT
}

enum NotificationType {
  ORDER_UPDATE
  DRIVER_ASSIGNED
  PROMO
  SYSTEM
}

// ─── USER ────────────────────────────────

model User {
  id          String    @id @default(uuid())
  displayId   String?
  userType    UserType  @default(CUSTOMER)
  status      Status    @default(ENABLED)
  loginType   LoginType @default(PHONE)
  userName    String?
  mobile      String?
  email       String?
  firebaseUId String?   @unique @db.VarChar(191)
  isAvailable Boolean   @default(false)
  fcmToken    String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  driverProfiles DriverProfile?
  addresses      Address[]
  orders         Order[]
  favorites      Favorite[]
  deliveries     Delivery[]
  notifications  Notification[]
  reviews        Review[]
  sessions       UserSession[]

  @@map("users")
}

// ─── USER SESSION ─────────────────────────

model UserSession {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  notificationToken String?  @db.Text
  status            Status   @default(ENABLED)
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("user_sessions")
}

// ─── DRIVER PROFILE ──────────────────────

model DriverProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id])
  // Identity
  driverPartnerId   String       @unique
  fullName          String?
  email             String?
  city              String?
  // Status & Stats
  driverStatus      DriverStatus @default(ACTIVE)
  rating            Decimal      @default(5.0) @db.Decimal(3, 2)
  totalDeliveries   Int          @default(0)
  todayDeliveries   Int          @default(0)
  todayEarnings     Decimal      @default(0) @db.Decimal(10, 2)
  weeklyEarnings    Decimal      @default(0) @db.Decimal(10, 2)
  weeklyGoal        Decimal      @default(6000) @db.Decimal(10, 2)
  // Online Presence
  isOnline          Boolean      @default(false)
  fcmToken          String?      @db.Text
  profilePhoto      String?      @db.Text
  // Vehicle
  vehicleName       String?
  plateNumber       String?
  licenseNumber     String?
  // Settings
  pushNotifications Boolean      @default(true)
  locationSharing   Boolean      @default(true)
  doNotDisturb      Boolean      @default(false)
  isDeleted         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  @@map("driver_profiles")
}

// ─── DRIVER OTP ───────────────────────────

model DriverOtp {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("driver_otps")
}

// ─── ADDRESS ─────────────────────────────

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  fullAddress String   @db.Text
  landmark    String?
  city        String
  state       String
  pincode     String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  orders Order[]

  @@map("addresses")
}

// ─── CATEGORY ────────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]

  @@map("categories")
}

// ─── PRODUCT ─────────────────────────────

model Product {
  id            String   @id @default(uuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  name          String
  description   String?  @db.Text
  imageUrl      String?
  price         Decimal  @db.Decimal(10, 2)
  stockQty      Int      @default(0)
  unitType      String
  ratingAvg     Float    @default(0)
  reviewCount   Int      @default(0)
  isActive      Boolean  @default(true)
  isBestSeller  Boolean  @default(false)
  isRecommended Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  orderItems    OrderItem[]
  favorites     Favorite[]
  inventoryLogs InventoryLog[]
  reviews       Review[]

  @@map("products")
}

// ─── DELIVERY SLOT ───────────────────────

model DeliverySlot {
  id        String   @id @default(uuid())
  label     String
  time      String
  maxOrders Int      @default(50)
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  orders Order[]

  @@map("delivery_slots")
}

// ─── ORDER ───────────────────────────────

model Order {
  id             String        @id @default(uuid())
  displayId      String
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  addressId      String
  address        Address       @relation(fields: [addressId], references: [id])
  slotId         String?
  slot           DeliverySlot? @relation(fields: [slotId], references: [id])
  status         OrderStatus   @default(PENDING)
  deliveryType   DeliveryType  @default(EXPRESS)
  scheduledDate  DateTime?
  subtotal       Decimal       @db.Decimal(10, 2)
  deliveryCharge Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  instructions   String?       @db.Text
  paymentMethod  String        @default("COD")
  isDeleted      Boolean       @default(false)
  placedAt       DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  items      OrderItem[]
  delivery   Delivery?
  statusLogs OrderStatusLog[]
  reviews    Review[]

  @@map("orders")
}

// ─── ORDER ITEM ──────────────────────────

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String
  imageUrl   String?
  unitType   String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

// ─── ORDER STATUS LOG ────────────────────

model OrderStatusLog {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id])
  deliveryId String?
  delivery   Delivery?   @relation(fields: [deliveryId], references: [id])
  status     OrderStatus
  note       String?
  changedBy  String
  changedAt  DateTime    @default(now())

  @@map("order_status_logs")
}

// ─── DELIVERY ────────────────────────────

model Delivery {
  id          String         @id @default(uuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id])
  driverId    String
  driver      User           @relation(fields: [driverId], references: [id])
  status      DeliveryStatus @default(PENDING)
  otp         String?
  otpVerified Boolean        @default(false)
  assignedAt  DateTime       @default(now())
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  isDeleted   Boolean        @default(false)
  updatedAt   DateTime       @default(now()) @updatedAt

  statusLogs OrderStatusLog[]

  @@map("deliveries")
}

// ─── FAVORITE ────────────────────────────

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, productId])
  @@map("favorites")
}

// ─── REVIEW ───────────────────────────────

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String?  @db.Text
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, productId, orderId])
  @@map("reviews")
}

// ─── INVENTORY LOG ───────────────────────

model InventoryLog {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  quantityChange Int
  reason         InventoryReason
  referenceId    String?
  changedBy      String
  createdAt      DateTime        @default(now())

  @@map("inventory_logs")
}

// ─── NOTIFICATION ─────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  body      String           @db.Text
  type      NotificationType
  imageUrl  String?
  isRead    Boolean          @default(false)
  isDeleted Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

// ─── APP SETTINGS ────────────────────────

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_settings")
}
